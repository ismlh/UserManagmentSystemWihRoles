@model ICollection<IdentityRole>

    <form asp-action="Create" asp-controller="RoleManager" method="get">
        <div class="form-group mb2">
            <label for="Name">
                Name
            </label>
            <input type="text" name="Name" class="form-control"  id="Name" value="" required  />
        @if (!ViewBag.isCoreect)
        {
            <span class="text-danger ms-4">Error.</span>
        }
    </div>
    <button type="submit" class="btn btn-outline-success mt-2">Add New Role</></button>

    </form>

<table class="table table-bordered text-center mt-3">
    <tr>
        <th>Role</th>

        <th></th>
        <th></th>
    </tr>
    @foreach (var role in Model)
    {
        <tr>
            <td>@role.Name</td>
            <td></td>
            <td></td>
        </tr>
    }

</table>






