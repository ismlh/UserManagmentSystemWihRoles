@model CustomUserManmgment.ViewModels.UpdateUserInfoViewModel

@{
    ViewData["Title"] = "Update User Information";
}

<h2>Update User Information</h2>
<form asp-action="Update" method="post" enctype="multipart/form-data">

    <div class="row">
        <div class="col-md-8">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ProfilePicture" class="control-label">Profile Picture</label>
                    <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-outline-primary mt-2 form-control">Update</button>
                </div>
        </div>
        <div class="col-md-4">
            <label asp-for="ProfilePicture" ></label>
            @if (Model.ProfilePicture != null)
            {
                // Convert binary data to Base64 string
                string imageBase64 = Convert.ToBase64String(Model.ProfilePicture);
                string imageSrc = string.Format("data:image/jpeg;base64,{0}", imageBase64);

                <img src="@imageSrc" alt="Profile Picture" class="w-100" />
            }
            else
            {
                <img src="~/Images/download.png" class="w-50" />
            }
        </div>
    </div>
</form>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}